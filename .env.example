# ==============================================================================
# SmartFarm AI - Global Environment Variable Template
# ==============================================================================

# --- BACKEND CONFIGURATION ---
# Database Connection String (PostgreSQL in production, SQLite for dev)
DATABASE_URL=postgresql://user:password@localhost:5432/smartfarm

# Redis Cache Connection URL (Optional)
REDIS_URL=redis://localhost:6379/0

# JWT & Application Security Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_string
SECRET_KEY=replace_with_a_secure_random_64_character_string

# Frontend Public URL (used for Google OAuth callback & CORS)
FRONTEND_URL=https://smartfarm-ai.vercel.app

# Allowed CORS Origins (Comma-separated or JSON Array string)
BACKEND_CORS_ORIGINS=["https://smartfarm-ai.vercel.app","http://localhost:5173"]

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://smartfarm-backend.onrender.com/api/auth/google/callback

# Third-Party AI & Weather Services
OPENWEATHERMAP_API_KEY=your_open_weather_map_api_key
GEMINI_API_KEY=your_google_gemini_api_key

# Error Logging & Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# --- FRONTEND CONFIGURATION ---
# Base API URL pointing to deployed backend service (leave blank for local proxying)
VITE_API_URL=https://smartfarm-backend.onrender.com
