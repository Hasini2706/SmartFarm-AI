# SmartFarm AI Backend Environment Variables

# Security
JWT_SECRET=super_secret_production_key_change_me_in_prod
SECRET_KEY=super_secret_production_key_change_me_in_prod

# Database & Cache
DATABASE_URL=sqlite:///./smartfarm.db
# DATABASE_URL=postgresql://smartfarm_user:password@localhost:5432/smartfarm
REDIS_URL=redis://localhost:6379/0

# CORS & Domain Settings
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://smartfarm-ai.vercel.app"]

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# External APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
GEMINI_API_KEY=your_gemini_api_key

# Monitoring
SENTRY_DSN=
