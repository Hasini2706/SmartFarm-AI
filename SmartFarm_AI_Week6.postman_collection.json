	"item": [
		{
			"name": "Register",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"farmer@example.com\",\n    \"username\": \"smartfarmer\",\n    \"password\": \"Password123!\",\n    \"full_name\": \"John Doe\",\n    \"name\": \"John Doe\",\n    \"role\": \"farmer\"\n}",
					"options": {
